{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/%USERPROFILE%/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#f2d5cf",
      "2": "#eebebe",
      "3": "#f4b8e4",
      "4": "#ef9f76",
      "5": "#e5c890",
      "6": "#a6d189",
      "7": "#81c8be",
      "8": "#99d1db",
      "9": "#85c1dc"
    },
    "padding": {
      "top": 1,
      "right": 3,
      "left": 0
    }
  },
  "display": {
    "separator": " ",
    "percent": {
      "type": ["bar", "num-color"],
      "color": {
        "green": "#a6d189",
        "yellow": "#e5c890",
        "red": "#e78284"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#f4b8e4",
        "at": "#c6d0f5",
        "host": "#99d1db"
      }
    },
    "break",
     {
      "type": "os",
      "key": "",
      "keyColor": "#99d1db"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "#f4b8e4"
    },
    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "#ef9f76"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#a6d189"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#81c8be"
    },
    {
      "type": "uptime",
      "key": "󰒲",
      "keyColor": "#e5c890"
    },
    {
      "type": "gpu",
      "key": "",
      "keyColor": "#e78284"
    },
    "break",
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
